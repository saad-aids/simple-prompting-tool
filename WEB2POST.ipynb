        "tavily_client = TavilyClient(\" Enter Your tavily client api key here ")\n",
        "\n",
        "def web_search(user_query):\n",
        "  response = tavily_client.search(query=user_query)\n",
        "\n",
        "  results = (response.get(\"results\"))\n",
        "\n",
        "  web_results = \"\"\n",
        "\n",
        "  for r in results:\n",
        "\n",
        "    web_results = web_results+r.get(\"content\")\n",
        "\n",
        "  return(web_results)\n",
        "\n",
        "\n",
        "web_search_results= web_search(user_query)\n",
        "print(web_search_results)\n"
