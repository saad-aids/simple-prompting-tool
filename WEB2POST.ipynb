        "def linkedin_agent(summary_results):\n",
        "    linkedin_prompt = f'''\n",
        "You are a personal branding expert on LinkedIn.\n",
        "\n",
        "Write a professional, insightful, and engaging LinkedIn post based on the summary below. The tone should be thoughtful and value-driven.\n",
        "\n",
        "User request:\n",
        "{summary_results}\n",
        "\n",
        "Guidelines:\n",
        "-- Write in the First Person.\n",
        "-- Keep it within 2–4 short paragraphs.\n",
        "-- Aim to educate, inspire, or provoke thought.\n",
        "'''\n",
        "    response = gemini_client.models.generate_content(\n",
        "        model=\"gemini-2.5-flash\",\n",
        "        contents=linkedin_prompt\n",
        "    )\n",
        "    return response.text\n",
        "\n",
        "# Example usage\n",
        "linkedin_results = linkedin_agent(summary_results)\n",
        "print(linkedin_results)\n"
      ],
